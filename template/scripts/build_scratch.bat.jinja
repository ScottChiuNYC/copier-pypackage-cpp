@echo off
setlocal
if "%~1"=="" (
    echo ERROR: Supply a standalone C++ source file.
    exit /b 2
)
if not exist "%~f1" (
    echo ERROR: Source file not found: "%~f1"
    exit /b 2
)
where cl.exe >nul 2>&1
if errorlevel 1 (
    echo ERROR: cl.exe unavailable. Start VS Code using open_vscode.bat.
    exit /b 1
)

set "OUT=%~dp0..\build\scratch"
if not exist "%OUT%" mkdir "%OUT%"
if errorlevel 1 exit /b %errorlevel%

pushd "%OUT%"
if errorlevel 1 exit /b %errorlevel%

cl.exe /nologo /EHsc /Zi {% if cpp_standard | int >= 23 %}/std:c++latest{% else %}/std:c++{{ cpp_standard }}{% endif %} "%~f1" /Fe:"%CD%\%~n1.exe"
set "RESULT=%errorlevel%"
popd
exit /b %RESULT%
