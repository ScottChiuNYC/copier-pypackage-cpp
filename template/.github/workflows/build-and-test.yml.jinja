name: Build and Test

# Contract-only ICC commits should not spend Linux/Windows build minutes.
# For push and pull_request, GitHub ignores the workflow only when ALL changed
# files match these two documentation paths. Code/build/test changes still run CI.
on:
  workflow_dispatch:
  push:
    paths-ignore:
      - 'docs/development/essence.md'
      - 'docs/development/ESSENCE_AUDIT.md'
  pull_request:
    paths-ignore:
      - 'docs/development/essence.md'
      - 'docs/development/ESSENCE_AUDIT.md'

permissions:
  contents: read

jobs:
  validate:
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-2022]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{ python_version.replace(">=", "") }}'
          cache: pip
          cache-dependency-path: scripts/tool-requirements.txt
      - uses: actions/cache@v4
        with:
          path: |
            ~/.cache/vcpkg/archives
            ~/AppData/Local/vcpkg/archives
          key: vcpkg-{% raw %}${{ runner.os }}{% endraw %}-{% raw %}${{ hashFiles('vcpkg-configuration.json', 'vcpkg-ports/**', 'scripts/tool-requirements.txt') }}{% endraw %}
      - name: Bootstrap pinned tools and vcpkg
        run: python scripts/bootstrap.py
      - name: Validate
        run: python scripts/validate.py --wheel
