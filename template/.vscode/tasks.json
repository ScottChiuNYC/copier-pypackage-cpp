{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (Windows)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "windows-vcpkg"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake: build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-debug"
            ],
            "dependsOn": [
                "CMake: configure (Windows)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake: build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-release"
            ],
            "dependsOn": [
                "CMake: configure (Windows)"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CTest: run (Debug)",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--preset",
                "windows-debug-tests"
            ],
            "dependsOn": [
                "CMake: build (Debug)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scratch: build active C++ (Windows)",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build_scratch.bat",
            "args": [
                "${file}"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Scratch: build active C++ (Linux)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/build_scratch.sh",
                "${file}"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
