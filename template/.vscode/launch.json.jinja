{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-vcpkg/tests/cpp/Debug/{{ module_name }}_core_test.exe",
            "stopAtEntry": false,
            "preLaunchTask": "CMake: build (Debug)",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Scratch: active C++ file (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\scratch\\${fileBasenameNoExtension}.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Scratch: build active C++ (Windows)",
            "console": "integratedTerminal"
        },
        {
            "name": "Scratch: active C++ file (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/scratch/${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Scratch: build active C++ (Linux)",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "externalConsole": false
        }
    ]
}
